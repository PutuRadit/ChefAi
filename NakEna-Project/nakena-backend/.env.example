# Salin file ini menjadi .env lalu isi nilai rahasia milikmu sendiri.
# Buat SECRET_KEY dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-random-secret-key-of-at-least-32-characters

# SQLite cocok untuk pengembangan lokal. Untuk deployment, gunakan PostgreSQL.
DATABASE_URL=sqlite:///./nakena.db
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend berjalan di port 8001. Pertahankan kedua origin localhost ini.
CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]

# Isi dengan API key baru dari Google AI Studio. Jangan commit file .env.
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Model YOLO disimpan di folder models/ backend.
YOLO_MODEL_PATH=models/chefai_best.pt
YOLO_CONFIDENCE=0.25

# Penyimpanan foto upload
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_RETENTION_DAYS=30
