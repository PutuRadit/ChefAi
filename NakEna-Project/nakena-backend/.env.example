# Salin file ini menjadi .env. Ganti nilai placeholder sebelum menjalankan aplikasi.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-key
DATABASE_URL=postgresql+psycopg2://chefai:chefai@localhost:5432/chefai
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origin frontend lokal (format JSON array)
CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001","http://localhost:5173","http://localhost:3000"]

# Upload foto bahan makanan
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_RETENTION_DAYS=30

# Isi API key baru dari Google AI Studio hanya di file .env lokal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Path model deteksi bahan (relatif dari folder nakena-backend atau path absolut)
YOLO_MODEL_PATH=models/chefai_best.pt
YOLO_CONFIDENCE=0.25
